#!/usr/bin/env bash

CONF_DIR="$HOME/akrb5"
STATE_FILE="$CONF_DIR/active"
mkdir -p "$CONF_DIR" 2>/dev/null

# ===================== HELP =====================
show_help() {
    if command -v kinit &>/dev/null; then
        echo "   krb5-user ✔ installed"
    else
        echo "   krb5-user ✘ not found — install with: sudo apt install -y krb5-user libsasl2-modules-gssapi-mit"
    fi
    cat <<'EOH'

Commands:
  akrb5                                → status + list of labs
  source akrb5 <lab>                   → activate lab (persists KRB5_CONFIG in current shell) ← recommended
  akrb5 <lab>                          → activate lab (only for current subshell)
  akrb5 create  <lab> <IP> <REALM>     → create a new lab
  akrb5 add-dc  <lab> <IP> [REALM]     → add a DC (defaults to lab default_realm)
  akrb5 remove-dc  <lab> <IP>          → remove a DC by IP
  akrb5 remove-realm <lab> <REALM>     → remove a realm block
  akrb5 delete <lab>                   → delete a lab completely
  akrb5 import nxc-ldap <lab> <file>   → parse NXC LDAP output and auto-generate krb5.conf
  akrb5 list                           → list available labs
  akrb5 --help | -h | help             → show this help

EOH
    return 0
}

# ===================== FUNCTIONS =====================

# Add a KDC IP to a realm inside a krb5.conf file.
# Usage: add_kdc <file> <REALM> <IP>
add_kdc() {
    local file="$1" realm="$2" ip="$3"

    if ! grep -q "^[[:space:]]*$realm = {" "$file" 2>/dev/null; then
        # Realm does not exist yet — append a new block
        cat >> "$file" <<EOL

    $realm = {
        kdc = $ip:88
        admin_server = $ip
    }
EOL
        echo "   Added realm $realm → $ip"
    else
        # Realm exists — add the KDC only if not already present
        if grep -q "kdc = $ip:88" "$file"; then
            echo "   kdc = $ip:88 already exists in $realm, skipping"
            return 0
        fi
        # Insert the new kdc line before admin_server inside the correct realm block
        awk -v realm="$realm" -v ip="$ip" '
            /^[[:space:]]*'"$realm"'[[:space:]]*=[[:space:]]*\{/ { in_realm=1 }
            in_realm && /admin_server/ {
                print "        kdc = " ip ":88"
                in_realm=0
            }
            { print }
        ' "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"
        echo "   Added kdc = $ip:88 to realm $realm"
    fi
}

# Remove all kdc lines matching an IP from a krb5.conf file.
# Usage: remove_dc <file> <IP>
remove_dc() {
    local file="$1" ip="$2"
    sed -i "/kdc = $ip:88/d" "$file"
    echo "   Removed kdc = $ip:88"
}

# Remove an entire realm block (and its domain_realm entries) from a krb5.conf file.
# Usage: remove_realm <file> <REALM>
remove_realm() {
    local file="$1" realm="$2"
    local domain
    domain=$(echo "$realm" | tr '[:upper:]' '[:lower:]')

    awk -v realm="$realm" '
        /^[[:space:]]*'"$realm"'[[:space:]]*=[[:space:]]*\{/ { skip=1 }
        skip && /^[[:space:]]*\}/ { skip=0; next }
        !skip { print }
    ' "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"

    sed -i "/[[:space:]]*\.$domain[[:space:]]*=[[:space:]]*$realm/d" "$file"
    sed -i "/[[:space:]]*$domain[[:space:]]*=[[:space:]]*$realm/d" "$file"
    sed -i '/^$/N;/^\n$/d' "$file"

    echo "   Removed realm $realm"
}

# ============================================================
# Generate krb5.conf from `nxc ldap` output
# v1.5: LDAP only responds on DCs — no heuristics needed.
#       Every host in the output is a confirmed DC.
# Usage: generate_krb5_from_nxc_ldap <input_file> <output_file>
# ============================================================
generate_krb5_from_nxc_ldap() {
    local input="$1"
    local output="$2"

    local realms_tmp
    realms_tmp=$(mktemp)

    while read -r line; do
        case "$line" in
            *LDAP*domain:*)
                local ip hostname domain realm
                ip=$(echo "$line" | awk '{print $2}')
                hostname=$(echo "$line" | sed -n 's/.*name:\([^ )]*\).*/\1/p')
                domain=$(echo "$line" | sed -n 's/.*domain:\([^ )]*\).*/\1/p')
                realm=$(echo "$domain" | tr '[:lower:]' '[:upper:]')
                echo "$realm $ip $hostname" >> "$realms_tmp"
                ;;
        esac
    done < "$input"

    if [ ! -s "$realms_tmp" ]; then
        echo "   No DCs found in $input — is this nxc ldap output?"
        rm "$realms_tmp"
        return 1
    fi

    {
        echo "[libdefaults]"
        local first_realm
        first_realm=$(awk '{print $1}' "$realms_tmp" | sort -u | head -n1)
        echo "    default_realm = $first_realm"
        echo "    dns_lookup_realm = false"
        echo "    dns_lookup_kdc = false"
        echo "    ticket_lifetime = 24h"
        echo "    forwardable = true"
        echo
        echo "[realms]"
        echo

        while read -r realm; do
            echo "    $realm = {"
            awk -v r="$realm" '$1==r {print "        kdc = " $2 ":88"}' "$realms_tmp"
            local admin_ip
            admin_ip=$(awk -v r="$realm" '$1==r {print $2; exit}' "$realms_tmp")
            echo "        admin_server = $admin_ip"
            echo "    }"
            echo
        done < <(awk '{print $1}' "$realms_tmp" | sort -u)

        echo "[domain_realm]"
        echo

        while read -r realm; do
            local domain
            domain=$(echo "$realm" | tr '[:upper:]' '[:lower:]')
            echo "    .$domain = $realm"
            echo "    $domain = $realm"
            echo
        done < <(awk '{print $1}' "$realms_tmp" | sort -u)

    } > "$output"

    rm "$realms_tmp"
    echo "✔ Generated: $output"
    echo

    # Summary
    echo "   Domain Controllers found:"
    while read -r line; do
        case "$line" in
            *LDAP*domain:*)
                local ip hostname domain
                ip=$(echo "$line" | awk '{print $2}')
                hostname=$(echo "$line" | sed -n 's/.*name:\([^ )]*\).*/\1/p')
                domain=$(echo "$line" | sed -n 's/.*domain:\([^ )]*\).*/\1/p' | tr '[:lower:]' '[:upper:]')
                printf "   %-15s %-12s %s  ✔\n" "$ip" "$hostname" "$domain"
                ;;
        esac
    done < "$input"
    echo
}

# ===================== MAIN =====================
case "${1:-}" in

    ""|current)
        cat <<'BANNER'

   ░███    ░██     ░██ ░█████████  ░████████   ░████████ 
  ░██░██   ░██    ░██  ░██     ░██ ░██    ░██  ░██       
 ░██  ░██  ░██   ░██   ░██     ░██ ░██    ░██  ░███████  
░█████████ ░███████    ░█████████  ░████████         ░██ 
░██    ░██ ░██   ░██   ░██   ░██   ░██     ░██ ░██   ░██ 
░██    ░██ ░██    ░██  ░██    ░██  ░██     ░██ ░██   ░██ 
░██    ░██ ░██     ░██ ░██     ░██ ░█████████   ░██████ V1.5
By Aki | Quick krb5.conf manager for Active Directory

BANNER
        LABS=$(ls "$CONF_DIR"/*.conf 2>/dev/null | xargs -n1 basename 2>/dev/null | sed 's/\.conf$//')
        if [ -n "$LABS" ]; then
            if [ -f "$STATE_FILE" ]; then
                ACTIVE=$(cat "$STATE_FILE")
                echo "Active → $(basename "$ACTIVE" .conf)"
            else
                echo "No active lab"
            fi
            echo
            echo "Available labs:"
            echo "$LABS" | sed 's/^/   → /' | sort
            echo
        fi
        show_help
        ;;

    help|-h|--help) show_help ;;

    create)
        [ $# -lt 4 ] && { echo "Usage: akrb5 create <lab> <IP> <REALM>"; return 1; }
        NAME="$2" IP="$3" REALM="$4"
        FILE="$CONF_DIR/$NAME.conf"
        DOMAIN=$(echo "$REALM" | tr '[:upper:]' '[:lower:]')
        cat > "$FILE" <<EOL
[libdefaults]
    default_realm = $REALM
    dns_lookup_realm = false
    dns_lookup_kdc = false
    ticket_lifetime = 24h
    forwardable = true

[realms]

    $REALM = {
        kdc = $IP:88
        admin_server = $IP
    }

[domain_realm]

    .$DOMAIN = $REALM
    $DOMAIN = $REALM
EOL
        echo "Created → $FILE"
        ;;

    add-dc)
        [ $# -lt 3 ] && { echo "Usage: akrb5 add-dc <lab> <IP> [REALM]"; return 1; }
        NAME="$2" IP="$3"
        FILE="$CONF_DIR/$NAME.conf"
        [ ! -f "$FILE" ] && { echo "$NAME.conf does not exist"; return 1; }
        if [ -n "${4:-}" ]; then
            REALM="$4"
        else
            REALM=$(grep -m1 "default_realm" "$FILE" | awk -F' = ' '{print $2}' | tr -d '[:space:]')
        fi
        add_kdc "$FILE" "$REALM" "$IP"
        ;;

    remove-dc)
        [ $# -lt 3 ] && { echo "Usage: akrb5 remove-dc <lab> <IP>"; return 1; }
        FILE="$CONF_DIR/$2.conf"
        [ ! -f "$FILE" ] && { echo "$2.conf does not exist"; return 1; }
        remove_dc "$FILE" "$3"
        ;;

    remove-realm)
        [ $# -lt 3 ] && { echo "Usage: akrb5 remove-realm <lab> <REALM>"; return 1; }
        FILE="$CONF_DIR/$2.conf"
        [ ! -f "$FILE" ] && { echo "$2.conf does not exist"; return 1; }
        remove_realm "$FILE" "$3"
        ;;

    delete)
        [ $# -lt 2 ] && { echo "Usage: akrb5 delete <lab>"; return 1; }
        rm -f "$CONF_DIR/$2.conf" && echo "Deleted $2.conf"
        ;;

    list)
        echo "Available labs:"
        ls "$CONF_DIR"/*.conf 2>/dev/null \
            | xargs -n1 basename 2>/dev/null \
            | sed 's/\.conf$//; s/^/   → /' \
            | sort \
            || echo "   (none)"
        ;;

    import)
        if [ "$2" = "nxc-ldap" ]; then
            [ $# -lt 4 ] && { echo "Usage: akrb5 import nxc-ldap <lab> <file>"; return 1; }
            NAME="$3"
            INFILE="$4"
            [ ! -f "$INFILE" ] && { echo "File not found: $INFILE"; return 1; }
            OUTFILE="$CONF_DIR/$NAME.conf"
            generate_krb5_from_nxc_ldap "$INFILE" "$OUTFILE"
        else
            echo "Unknown import source: $2"
            echo "Usage: akrb5 import nxc-ldap <lab> <file>"
            return 1
        fi
        ;;

    *)
        FILE="$CONF_DIR/$1.conf"
        if [ -f "$FILE" ]; then
            export KRB5_CONFIG="$FILE"
            echo "$FILE" > "$STATE_FILE"
            echo "Kerberos activated → $1 ($FILE)"
        else
            echo "$1.conf does not exist"
            show_help
            return 1
        fi
        ;;
esac
